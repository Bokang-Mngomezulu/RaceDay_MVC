@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="rd-heading mb-0">Organiser dashboard</h1>
        <p class="text-muted mb-0">Welcome back, @Context.Session.FullName()</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-rd">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.TotalEvents</div>
            <div class="rd-stat-label">Events created</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.TotalEnrolments</div>
            <div class="rd-stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.Upcoming.Count</div>
            <div class="rd-stat-label">Upcoming events</div>
        </div>
    </div>
</div>

@if (Model.TotalEvents == 0)
{
    <div class="card rd-card">
        <div class="card-body text-center py-5">
            <h2 class="rd-heading h4">You haven't created any events yet</h2>
            <p class="text-muted">Create your first event to start taking enrolments.</p>
            <a asp-action="CreateEvent" class="btn btn-rd">Create your first event</a>
        </div>
    </div>
}
else
{
    <h2 class="rd-heading h4 mb-3">Upcoming events</h2>
    @if (Model.Upcoming.Count == 0)
    {
        <p class="text-muted">No upcoming events. Past events are listed below.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Location</th><th class="text-center">Enrolments</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Upcoming)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Name</td>
                            <td>@UiHelpers.FormatDate(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td class="text-center"><span class="badge text-bg-dark">@e.EnrolmentCount</span></td>
                            <td class="text-end">
                                <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-outline-rd btn-sm">View enrolments</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Past.Count > 0)
    {
        <h2 class="rd-heading h4 mb-3">Past events</h2>
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Location</th><th class="text-center">Enrolments</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Past)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Name</td>
                            <td>@UiHelpers.FormatDate(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td class="text-center"><span class="badge text-bg-dark">@e.EnrolmentCount</span></td>
                            <td class="text-end">
                                <a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-outline-rd btn-sm">Enter results</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}